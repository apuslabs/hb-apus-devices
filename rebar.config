{erl_opts, [debug_info]}.

{deps, [
    {hb, {git, "https://github.com/apuslabs/HyperBEAM.git",
        {ref, "28baa3d27d70c4268f439587ba0398fb7771e0e3"}}}
]}.

{plugins, [
    {plugin,
        {git_subdir, "https://github.com/apuslabs/HyperBEAM.git",
            {ref, "28baa3d27d70c4268f439587ba0398fb7771e0e3"},
            "src/forge"}},
    {rebar3_eunit_start,
        {git, "https://github.com/permaweb/rebar3_eunit_start.git",
            {ref, "04ec53fea187039770db0d4459b7aeb01a9021af"}}}
]}.

{eunit_opts, [verbose, {start_applications, [prometheus, hb]}]}.

{shell, [
    {apps, [hb]}
]}.

{alias, [
    {'eunit-all', [
        {device, "test --with-core --device-src=src,vendor/permaweb-os/src"}
    ]}
]}.

{provider_hooks, [
    {pre, [
        {eunit, {default, rebar3_eunit_start}}
    ]}
]}.
