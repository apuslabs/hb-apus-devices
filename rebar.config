{erl_opts, [debug_info]}.

{deps, [
    %% HyperBEAM core comes from upstream. This pin is also the kernel the
    %% node runs, so read docs/hyperbeam-pin.md before changing it.
    {hb, {git, "https://github.com/permaweb/HyperBEAM.git",
        {ref, "1aebe74afd88f5fa35b188a16bd10aac04c4541e"}}}
]}.

{plugins, [
    {plugin,
        {git_subdir, "https://github.com/permaweb/HyperBEAM.git",
            {ref, "1aebe74afd88f5fa35b188a16bd10aac04c4541e"},
            "src/forge"}},
    {rebar3_eunit_start,
        {git, "https://github.com/permaweb/rebar3_eunit_start.git",
            {ref, "04ec53fea187039770db0d4459b7aeb01a9021af"}}}
]}.

{eunit_opts, [verbose, {start_applications, [prometheus, hb]}]}.

{shell, [
    {apps, [hb]}
]}.

{alias, [
    {'eunit-all', [
        {device, "test --with-core --device-src=src,vendor/permaweb-os/src"}
    ]}
]}.

{provider_hooks, [
    {pre, [
        {eunit, {default, rebar3_eunit_start}}
    ]}
]}.
